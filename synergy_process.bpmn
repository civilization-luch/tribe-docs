<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_synergy_process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="opencode" exporterVersion="1.0">
  <bpmn:message id="Msg_request" name="Запрос на поручительство" />
  <bpmn:message id="Msg_response" name="Согласие / отказ" />
  <bpmn:message id="Msg_deposit" name="Перевод депозита" />
  <bpmn:message id="Msg_deposit_ok" name="Депозит принят" />
  <bpmn:collaboration id="Collaboration_synergy">
    <bpmn:participant id="Participant_new" name="Новый участник" processRef="Process_new" />
    <bpmn:participant id="Participant_members" name="Другие участники" processRef="Process_members" />
    <bpmn:participant id="Participant_platform" name="Платформа (Treasury)" processRef="Process_platform" />
    <bpmn:messageFlow id="MF_request" sourceRef="Sub_find_guarantors" targetRef="MsgStart_members_request" messageRef="Msg_request" />
    <bpmn:messageFlow id="MF_agree" name="Согласие" sourceRef="Throw_members_accept" targetRef="Sub_find_guarantors" messageRef="Msg_response" />
    <bpmn:messageFlow id="MF_decline" name="Отказ" sourceRef="Throw_members_decline" targetRef="Sub_find_guarantors" messageRef="Msg_response" />
    <bpmn:messageFlow id="MF_deposit_members" name="Перевод депозита" sourceRef="Sub_deposit" targetRef="MsgStart_members_deposit" messageRef="Msg_deposit" />
    <bpmn:messageFlow id="MF_deposit_ok" name="Депозит принят" sourceRef="Throw_members_deposit_ok" targetRef="Sub_deposit" messageRef="Msg_deposit_ok" />
    <bpmn:messageFlow id="MF_deposit_platform" name="Перевод депозита" sourceRef="Sub_deposit" targetRef="MsgStart_platform_deposit" messageRef="Msg_deposit" />
  </bpmn:collaboration>
  <bpmn:process id="Process_new" isExecutable="false">
    <bpmn:startEvent id="StartEvent_new">
      <bpmn:outgoing>Flow_new_start_subA</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_new" name="Полноценный участник">
      <bpmn:incoming>Flow_new_subB_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_new_start_subA" sourceRef="StartEvent_new" targetRef="Sub_find_guarantors" />
    <bpmn:sequenceFlow id="Flow_new_subA_subB" sourceRef="Sub_find_guarantors" targetRef="Sub_deposit" />
    <bpmn:sequenceFlow id="Flow_new_subB_end" sourceRef="Sub_deposit" targetRef="EndEvent_new" />
    <bpmn:subProcess id="Sub_find_guarantors" name="Поиск двух поручителей">
      <bpmn:incoming>Flow_new_start_subA</bpmn:incoming>
      <bpmn:outgoing>Flow_new_subA_subB</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_find">
        <bpmn:outgoing>Flow_find_start_compose</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Task_find_compose" name="Составить запрос на поручительство">
        <bpmn:incoming>Flow_find_start_compose</bpmn:incoming>
        <bpmn:incoming>Flow_find_gw_loop</bpmn:incoming>
        <bpmn:outgoing>Flow_find_compose_req</bpmn:outgoing>
      </bpmn:task>
      <bpmn:intermediateThrowEvent id="ThrowEvent_find_request" name="Запрос на поручительство">
        <bpmn:incoming>Flow_find_compose_req</bpmn:incoming>
        <bpmn:messageEventDefinition messageRef="Msg_request" />
      </bpmn:intermediateThrowEvent>
      <bpmn:intermediateCatchEvent id="CatchEvent_find_response" name="Согласие / отказ">
        <bpmn:outgoing>Flow_find_catch_gw</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_response" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="Gateway_find_two" name="2 согласия?">
        <bpmn:incoming>Flow_find_catch_gw</bpmn:incoming>
        <bpmn:outgoing>Flow_find_gw_end</bpmn:outgoing>
        <bpmn:outgoing>Flow_find_gw_loop</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndEvent_find" name="Поручители найдены">
        <bpmn:incoming>Flow_find_gw_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_find_start_compose" sourceRef="StartEvent_find" targetRef="Task_find_compose" />
      <bpmn:sequenceFlow id="Flow_find_compose_req" sourceRef="Task_find_compose" targetRef="ThrowEvent_find_request" />
      <bpmn:sequenceFlow id="Flow_find_catch_gw" sourceRef="CatchEvent_find_response" targetRef="Gateway_find_two" />
      <bpmn:sequenceFlow id="Flow_find_gw_end" name="да" sourceRef="Gateway_find_two" targetRef="EndEvent_find" />
      <bpmn:sequenceFlow id="Flow_find_gw_loop" name="нет" sourceRef="Gateway_find_two" targetRef="Task_find_compose" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_deposit" name="Передача депозита поручителям">
      <bpmn:incoming>Flow_new_subA_subB</bpmn:incoming>
      <bpmn:outgoing>Flow_new_subB_end</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_deposit">
        <bpmn:outgoing>Flow_dep_start_size</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Task_deposit_size" name="Определить размер депозита">
        <bpmn:incoming>Flow_dep_start_size</bpmn:incoming>
        <bpmn:outgoing>Flow_dep_size_throw</bpmn:outgoing>
      </bpmn:task>
      <bpmn:intermediateThrowEvent id="ThrowEvent_deposit" name="Перевод депозита">
        <bpmn:incoming>Flow_dep_size_throw</bpmn:incoming>
        <bpmn:messageEventDefinition messageRef="Msg_deposit" />
      </bpmn:intermediateThrowEvent>
      <bpmn:intermediateCatchEvent id="CatchEvent_deposit_ok" name="Депозит принят">
        <bpmn:outgoing>Flow_dep_catch_end</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_deposit_ok" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="EndEvent_deposit">
        <bpmn:incoming>Flow_dep_catch_end</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_dep_start_size" sourceRef="StartEvent_deposit" targetRef="Task_deposit_size" />
      <bpmn:sequenceFlow id="Flow_dep_size_throw" sourceRef="Task_deposit_size" targetRef="ThrowEvent_deposit" />
      <bpmn:sequenceFlow id="Flow_dep_catch_end" sourceRef="CatchEvent_deposit_ok" targetRef="EndEvent_deposit" />
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:process id="Process_members" isExecutable="false">
    <bpmn:endEvent id="EndEvent_members_accept">
      <bpmn:incoming>Flow_mem_accept_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="MsgStart_members_deposit" name="Перевод депозита">
      <bpmn:outgoing>Flow_mem_dep_review</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_deposit" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_members_decide" name="Согласиться?">
      <bpmn:incoming>Flow_mem_review_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_mem_gw_accept</bpmn:outgoing>
      <bpmn:outgoing>Flow_1fo9dtt</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="MsgStart_members_request" name="Запрос на поручительство">
      <bpmn:outgoing>Flow_mem_req_review</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_request" />
    </bpmn:startEvent>
    <bpmn:task id="Task_members_review" name="Рассмотреть кандидата">
      <bpmn:incoming>Flow_mem_req_review</bpmn:incoming>
      <bpmn:outgoing>Flow_mem_review_gw</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="Throw_members_accept" name="Согласие">
      <bpmn:incoming>Flow_mem_gw_accept</bpmn:incoming>
      <bpmn:outgoing>Flow_mem_accept_end</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_response" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Throw_members_decline" name="Отказ">
      <bpmn:incoming>Flow_1fo9dtt</bpmn:incoming>
      <bpmn:outgoing>Flow_mem_decline_end</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_response" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="EndEvent_members_decline">
      <bpmn:incoming>Flow_mem_decline_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_mem_accept_end" sourceRef="Throw_members_accept" targetRef="EndEvent_members_accept" />
    <bpmn:sequenceFlow id="Flow_mem_dep_review" sourceRef="MsgStart_members_deposit" targetRef="Task_members_accept_deposit" />
    <bpmn:sequenceFlow id="Flow_mem_review_throw" sourceRef="Task_members_accept_deposit" targetRef="Throw_members_deposit_ok" />
    <bpmn:sequenceFlow id="Flow_mem_throw_end" sourceRef="Throw_members_deposit_ok" targetRef="EndEvent_members_deposit" />
    <bpmn:sequenceFlow id="Flow_mem_review_gw" sourceRef="Task_members_review" targetRef="Gateway_members_decide" />
    <bpmn:sequenceFlow id="Flow_mem_gw_accept" name="да" sourceRef="Gateway_members_decide" targetRef="Throw_members_accept" />
    <bpmn:sequenceFlow id="Flow_1fo9dtt" name="нет" sourceRef="Gateway_members_decide" targetRef="Throw_members_decline" />
    <bpmn:sequenceFlow id="Flow_mem_req_review" sourceRef="MsgStart_members_request" targetRef="Task_members_review" />
    <bpmn:sequenceFlow id="Flow_mem_decline_end" sourceRef="Throw_members_decline" targetRef="EndEvent_members_decline" />
    <bpmn:endEvent id="EndEvent_members_deposit">
      <bpmn:incoming>Flow_mem_throw_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_members_accept_deposit" name="Принять депозит">
      <bpmn:incoming>Flow_mem_dep_review</bpmn:incoming>
      <bpmn:outgoing>Flow_mem_review_throw</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="Throw_members_deposit_ok" name="Депозит принят">
      <bpmn:incoming>Flow_mem_review_throw</bpmn:incoming>
      <bpmn:outgoing>Flow_mem_throw_end</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_deposit_ok" />
    </bpmn:intermediateThrowEvent>
  </bpmn:process>
  <bpmn:process id="Process_platform" isExecutable="false">
    <bpmn:startEvent id="MsgStart_platform_deposit" name="Перевод депозита">
      <bpmn:outgoing>Flow_plat_start_reg</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_deposit" />
    </bpmn:startEvent>
    <bpmn:task id="Task_platform_register" name="Зарегистрировать депозит (Treasury/Billing)">
      <bpmn:incoming>Flow_plat_start_reg</bpmn:incoming>
      <bpmn:outgoing>Flow_plat_reg_receipt</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_platform_receipt" name="Выдать квитанцию">
      <bpmn:incoming>Flow_plat_reg_receipt</bpmn:incoming>
      <bpmn:outgoing>Flow_plat_receipt_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_platform">
      <bpmn:incoming>Flow_plat_receipt_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_plat_start_reg" sourceRef="MsgStart_platform_deposit" targetRef="Task_platform_register" />
    <bpmn:sequenceFlow id="Flow_plat_reg_receipt" sourceRef="Task_platform_register" targetRef="Task_platform_receipt" />
    <bpmn:sequenceFlow id="Flow_plat_receipt_end" sourceRef="Task_platform_receipt" targetRef="EndEvent_platform" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_synergy">
