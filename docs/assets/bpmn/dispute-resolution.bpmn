<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Dispute" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Dispute">
      <bpmn:lane id="Lane_Parties" name="Стороны сделки">
        <bpmn:flowNodeRef>Start_Dispute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Mutual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MutualCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Mutual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Open</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Panel" name="Первая линия поручителей">
        <bpmn:flowNodeRef>Task_Panel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Vote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Majority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Execute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deadlock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Lock</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Dispute" name="Спор открыт">
      <bpmn:outgoing>Flow_D_Start_Open</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Open" name="Открыть спор и указать причину">
      <bpmn:incoming>Flow_D_Start_Open</bpmn:incoming>
      <bpmn:outgoing>Flow_D_Open_Evidence</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Evidence" name="Загрузить доказательства">
      <bpmn:incoming>Flow_D_Open_Evidence</bpmn:incoming>
      <bpmn:outgoing>Flow_D_Evidence_Panel</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Mutual" name="Стороны согласны на возврат?">
      <bpmn:incoming>Flow_D_Lock_Mutual</bpmn:incoming>
      <bpmn:outgoing>Flow_D_Mutual_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_D_Mutual_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_MutualCancel" name="Подтвердить взаимный возврат">
      <bpmn:incoming>Flow_D_Mutual_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_D_Mutual_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Mutual" name="Покрытие освобождено">
      <bpmn:incoming>Flow_D_Mutual_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Open" name="Deadlock: покрытие заблокировано">
      <bpmn:incoming>Flow_D_Mutual_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Panel" name="Определить панель: поручители с блокировкой">
      <bpmn:incoming>Flow_D_Evidence_Panel</bpmn:incoming>
      <bpmn:outgoing>Flow_D_Panel_Conflict</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Conflict" name="Исключить заинтересованных">
      <bpmn:incoming>Flow_D_Panel_Conflict</bpmn:incoming>
      <bpmn:outgoing>Flow_D_Conflict_Vote</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Vote" name="Голосование 72 часа">
      <bpmn:incoming>Flow_D_Conflict_Vote</bpmn:incoming>
      <bpmn:outgoing>Flow_D_Vote_Majority</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Majority" name="Большинство за 72 ч?">
      <bpmn:incoming>Flow_D_Vote_Majority</bpmn:incoming>
      <bpmn:outgoing>Flow_D_Majority_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_D_Majority_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Decision" name="Зафиксировать решение">
      <bpmn:incoming>Flow_D_Majority_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_D_Decision_Execute</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Execute" name="Выплата или возврат по решению">
      <bpmn:incoming>Flow_D_Decision_Execute</bpmn:incoming>
      <bpmn:outgoing>Flow_D_Execute_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Resolved" name="Решение исполнено">
      <bpmn:incoming>Flow_D_Execute_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Deadlock" name="Зафиксировать deadlock">
      <bpmn:incoming>Flow_D_Majority_No</bpmn:incoming>
      <bpmn:outgoing>Flow_D_Deadlock_Lock</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Lock" name="Покрытие остаётся заблокированным">
      <bpmn:incoming>Flow_D_Deadlock_Lock</bpmn:incoming>
      <bpmn:outgoing>Flow_D_Lock_Mutual</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_D_Start_Open" sourceRef="Start_Dispute" targetRef="Task_Open" />
    <bpmn:sequenceFlow id="Flow_D_Open_Evidence" sourceRef="Task_Open" targetRef="Task_Evidence" />
    <bpmn:sequenceFlow id="Flow_D_Evidence_Panel" sourceRef="Task_Evidence" targetRef="Task_Panel" />
    <bpmn:sequenceFlow id="Flow_D_Panel_Conflict" sourceRef="Task_Panel" targetRef="Task_Conflict" />
    <bpmn:sequenceFlow id="Flow_D_Conflict_Vote" sourceRef="Task_Conflict" targetRef="Task_Vote" />
    <bpmn:sequenceFlow id="Flow_D_Vote_Majority" sourceRef="Task_Vote" targetRef="Gateway_Majority" />
    <bpmn:sequenceFlow id="Flow_D_Majority_Yes" name="большинство" sourceRef="Gateway_Majority" targetRef="Task_Decision" />
    <bpmn:sequenceFlow id="Flow_D_Decision_Execute" sourceRef="Task_Decision" targetRef="Task_Execute" />
    <bpmn:sequenceFlow id="Flow_D_Execute_End" sourceRef="Task_Execute" targetRef="End_Resolved" />
    <bpmn:sequenceFlow id="Flow_D_Majority_No" name="равенство" sourceRef="Gateway_Majority" targetRef="Task_Deadlock" />
    <bpmn:sequenceFlow id="Flow_D_Deadlock_Lock" sourceRef="Task_Deadlock" targetRef="Task_Lock" />
    <bpmn:sequenceFlow id="Flow_D_Lock_Mutual" sourceRef="Task_Lock" targetRef="Gateway_Mutual" />
    <bpmn:sequenceFlow id="Flow_D_Mutual_Yes" name="да" sourceRef="Gateway_Mutual" targetRef="Task_MutualCancel" />
    <bpmn:sequenceFlow id="Flow_D_Mutual_End" sourceRef="Task_MutualCancel" targetRef="End_Mutual" />
    <bpmn:sequenceFlow id="Flow_D_Mutual_No" name="нет" sourceRef="Gateway_Mutual" targetRef="End_Open" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Dispute">
    <bpmn:participant id="Participant_Dispute" name="Спор первой линии" processRef="Process_Dispute" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Dispute">
      <bpmndi:BPMNShape id="Participant_Dispute_di" bpmnElement="Participant_Dispute" isHorizontal="true">
        <dc:Bounds x="160" y="50" width="1800" height="630" />
      </bpmndi:BPMNShape>
