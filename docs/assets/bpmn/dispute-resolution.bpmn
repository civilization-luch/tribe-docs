      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_D_Start_Open_di" bpmnElement="Flow_D_Start_Open">
        <di:waypoint x="256" y="160" />
        <di:waypoint x="300" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_D_Open_Evidence_di" bpmnElement="Flow_D_Open_Evidence">
        <di:waypoint x="420" y="160" />
        <di:waypoint x="460" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_D_Evidence_Panel_di" bpmnElement="Flow_D_Evidence_Panel">
        <di:waypoint x="530" y="200" />
        <di:waypoint x="530" y="290" />
        <di:waypoint x="710" y="290" />
        <di:waypoint x="710" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_D_Panel_Conflict_di" bpmnElement="Flow_D_Panel_Conflict">
        <di:waypoint x="800" y="420" />
        <di:waypoint x="840" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_D_Conflict_Vote_di" bpmnElement="Flow_D_Conflict_Vote">
        <di:waypoint x="980" y="420" />
        <di:waypoint x="1020" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_D_Vote_Majority_di" bpmnElement="Flow_D_Vote_Majority">
        <di:waypoint x="1160" y="420" />
        <di:waypoint x="1200" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_D_Majority_Yes_di" bpmnElement="Flow_D_Majority_Yes">
        <di:waypoint x="1250" y="420" />
        <di:waypoint x="1300" y="420" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1265" y="413" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_D_Decision_Execute_di" bpmnElement="Flow_D_Decision_Execute">
