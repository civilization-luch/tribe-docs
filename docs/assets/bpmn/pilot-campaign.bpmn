          <dc:Bounds x="445" y="145" width="90" height="50" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Fit_di" bpmnElement="Gateway_Fit">
        <dc:Bounds x="580" y="135" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="555" y="189" width="100" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Wait_di" bpmnElement="Task_Wait">
        <dc:Bounds x="680" y="120" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="685" y="145" width="90" height="50" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Wait_di" bpmnElement="End_Wait">
        <dc:Bounds x="820" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="800" y="182" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Metrics_di" bpmnElement="Task_Metrics">
        <dc:Bounds x="2020" y="120" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2025" y="145" width="90" height="50" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_GoNoGo_di" bpmnElement="Gateway_GoNoGo">
        <dc:Bounds x="2160" y="135" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2135" y="189" width="100" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Scale_di" bpmnElement="Task_Scale">
        <dc:Bounds x="2260" y="90" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2265" y="115" width="90" height="50" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Stop_di" bpmnElement="Task_Stop">
        <dc:Bounds x="2260" y="190" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2265" y="215" width="90" height="50" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Scale_di" bpmnElement="End_Scale">
        <dc:Bounds x="2400" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2380" y="152" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Stop_di" bpmnElement="End_Stop">
        <dc:Bounds x="2400" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2380" y="252" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Call_di" bpmnElement="Task_Call">
        <dc:Bounds x="360" y="360" width="100" height="80" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="365" y="385" width="90" height="50" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Commit_di" bpmnElement="Gateway_Commit">
