<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_DepositCustody" isExecutable="false">
    <bpmn:laneSet id="LaneSet_DepositCustody">
      <bpmn:lane id="Lane_Depositor" name="Депозитор">
        <bpmn:flowNodeRef>Start_Cycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Guarantor" name="Поручитель">
        <bpmn:flowNodeRef>Task_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Cover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Dispute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Dispute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Cycle</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Cycle" name="Участник хочет депозит">
      <bpmn:outgoing>Flow_C_Start_Offer</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Offer" name="Отправить оффер">
      <bpmn:incoming>Flow_C_Start_Offer</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Offer_Accept</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Sent" name="Отметить передачу">
      <bpmn:incoming>Flow_C_Cover_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Sent_Receipt</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Deal" name="Депозит подтверждён">
      <bpmn:incoming>Flow_C_Ok_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Deal_Request</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Request" name="Запросить возврат">
      <bpmn:incoming>Flow_C_Deal_Request</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Request_Confirm</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Accept" name="Принять, резерв 1:1">
      <bpmn:incoming>Flow_C_Offer_Accept</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Accept_Cover</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Cover" name="Залог ≥ суммы?">
      <bpmn:incoming>Flow_C_Accept_Cover</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Cover_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_Cover_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Reject" name="Отклонить">
      <bpmn:incoming>Flow_C_Cover_No</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Reject_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Reject" name="Конец">
      <bpmn:incoming>Flow_C_Reject_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Receipt" name="Подтвердить получение">
      <bpmn:incoming>Flow_C_Sent_Receipt</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Receipt_Ok</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Ok" name="Получено?">
      <bpmn:incoming>Flow_C_Receipt_Ok</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Ok_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_Ok_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Dispute" name="Спор / возврат">
      <bpmn:incoming>Flow_C_Ok_No</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Dispute_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Dispute" name="Конец">
      <bpmn:incoming>Flow_C_Dispute_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Confirm" name="Подтвердить возврат второй стороной">
      <bpmn:incoming>Flow_C_Request_Confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Confirm_Release</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Release" name="Освободить резерв">
      <bpmn:incoming>Flow_C_Confirm_Release</bpmn:incoming>
      <bpmn:outgoing>Flow_C_Release_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Cycle" name="Резерв свободен">
      <bpmn:incoming>Flow_C_Release_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C_Start_Offer" sourceRef="Start_Cycle" targetRef="Task_Offer" />
    <bpmn:sequenceFlow id="Flow_C_Offer_Accept" sourceRef="Task_Offer" targetRef="Task_Accept" />
    <bpmn:sequenceFlow id="Flow_C_Accept_Cover" sourceRef="Task_Accept" targetRef="Gateway_Cover" />
    <bpmn:sequenceFlow id="Flow_C_Cover_No" name="нет" sourceRef="Gateway_Cover" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="Flow_C_Reject_End" sourceRef="Task_Reject" targetRef="End_Reject" />
    <bpmn:sequenceFlow id="Flow_C_Cover_Yes" name="да" sourceRef="Gateway_Cover" targetRef="Task_Sent" />
    <bpmn:sequenceFlow id="Flow_C_Sent_Receipt" sourceRef="Task_Sent" targetRef="Task_Receipt" />
    <bpmn:sequenceFlow id="Flow_C_Receipt_Ok" sourceRef="Task_Receipt" targetRef="Gateway_Ok" />
    <bpmn:sequenceFlow id="Flow_C_Ok_No" name="нет" sourceRef="Gateway_Ok" targetRef="Task_Dispute" />
    <bpmn:sequenceFlow id="Flow_C_Dispute_End" sourceRef="Task_Dispute" targetRef="End_Dispute" />
    <bpmn:sequenceFlow id="Flow_C_Ok_Yes" name="да" sourceRef="Gateway_Ok" targetRef="Task_Deal" />
    <bpmn:sequenceFlow id="Flow_C_Deal_Request" sourceRef="Task_Deal" targetRef="Task_Request" />
    <bpmn:sequenceFlow id="Flow_C_Request_Confirm" sourceRef="Task_Request" targetRef="Task_Confirm" />
    <bpmn:sequenceFlow id="Flow_C_Confirm_Release" sourceRef="Task_Confirm" targetRef="Task_Release" />
    <bpmn:sequenceFlow id="Flow_C_Release_End" sourceRef="Task_Release" targetRef="End_Cycle" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_DepositCustody">
    <bpmn:participant id="Participant_DepositCustody" name="Передача депозита поручителю" processRef="Process_DepositCustody" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_DepositCustody">
      <bpmndi:BPMNShape id="Participant_DepositCustody_di" bpmnElement="Participant_DepositCustody" isHorizontal="true">
        <dc:Bounds x="160" y="50" width="1140" height="510" />
