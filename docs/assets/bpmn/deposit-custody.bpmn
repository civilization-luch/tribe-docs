      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C_Offer_Accept_di" bpmnElement="Flow_C_Offer_Accept">
        <di:waypoint x="350" y="200" />
        <di:waypoint x="350" y="270" />
        <di:waypoint x="350" y="270" />
        <di:waypoint x="350" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C_Accept_Cover_di" bpmnElement="Flow_C_Accept_Cover">
        <di:waypoint x="400" y="380" />
        <di:waypoint x="460" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C_Cover_No_di" bpmnElement="Flow_C_Cover_No">
        <di:waypoint x="485" y="405" />
        <di:waypoint x="485" y="422" />
        <di:waypoint x="610" y="422" />
        <di:waypoint x="610" y="440" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="538" y="416" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C_Reject_End_di" bpmnElement="Flow_C_Reject_End">
        <di:waypoint x="660" y="480" />
        <di:waypoint x="700" y="480" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C_Cover_Yes_di" bpmnElement="Flow_C_Cover_Yes">
        <di:waypoint x="485" y="355" />
        <di:waypoint x="485" y="278" />
        <di:waypoint x="510" y="278" />
        <di:waypoint x="510" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="488" y="270" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
