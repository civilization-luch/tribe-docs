{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tasks & Projects Events",
  "description": "Event contracts for the merged Tasks & Projects module",
  "definitions": {
    "ProjectCreated": {
      "type": "object",
      "properties": {
        "aggregate_id": { "type": "string", "description": "Project ULID" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "owner_id": { "type": "string", "description": "User ULID" }
      },
      "required": ["aggregate_id", "name", "owner_id"]
    },
    "ProjectUpdated": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "ProjectItemIterationChanged": {
      "type": "object",
      "description": "Emitted when a project item (linked to an issue) is moved to a different iteration",
      "properties": {
        "item_id": { "type": "string", "description": "Project item ULID" },
        "issue_id": { "type": "string", "description": "Linked issue ULID" },
        "old_iteration_id": { "type": "string", "description": "Previous iteration id or empty string" },
        "new_iteration_id": { "type": "string", "description": "New iteration id or empty string" },
        "recurring": { "type": "boolean", "description": "True when the item is a recurring task" },
        "recurring_status": { "type": "string", "description": "Status to reset the item to for a new cycle" }
      },
      "required": ["item_id", "issue_id", "old_iteration_id", "new_iteration_id", "recurring"]
    },
    "ProjectArchived": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "MilestoneAdded": {
      "type": "object",
      "properties": {
        "milestone_id": { "type": "string" },
        "name": { "type": "string" },
        "due_date": { "type": "string", "format": "date" }
      },
      "required": ["milestone_id", "name"]
    },
    "MilestoneReached": {
      "type": "object",
      "properties": {
        "milestone_id": { "type": "string" }
      },
      "required": ["milestone_id"]
    },
    "TaskCreated": {
      "type": "object",
      "properties": {
        "aggregate_id": { "type": "string", "description": "Task ULID" },
        "project_id": { "type": "string", "description": "Project ULID or null" },
        "milestone_id": { "type": "string", "description": "Milestone ULID or null" },
        "title": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["aggregate_id", "title"]
    },
    "TaskUpdated": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "TaskAssigned": {
      "type": "object",
      "properties": {
        "assignee_id": { "type": "string", "description": "User ULID" }
      },
      "required": ["assignee_id"]
    },
    "TaskCompleted": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  }
}
