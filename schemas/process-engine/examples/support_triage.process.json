{
  "schemaVersion": "0.4",
  "id": "support.triage",
  "name": "Разбор обращения",
  "description": "Разбор обращения и работа по нему: принять, отклонить, уточнить или решить. После решения обращение ждёт подтверждения заявителя: ответ возвращает его в работу, молчание закрывает окно. Остальные переходы статусов выполняются в домене.",
  "version": "2026-11-04",
  "contextType": "support_request",
  "host": {
    "module": "support",
    "stateMap": {
      "new": "triage"
    },
    "contextUrl": "/community/{community}/support/{id}",
    "contextPreview": [
      {
        "field": "title",
        "label": "Тема"
      },
      {
        "field": "body",
        "label": "Текст"
      }
    ]
  },
  "passport": {
    "owner": "support_agent",
    "goal": "Разобрать обращение и довести до решения",
    "startsWhen": "обращение создано",
    "endsWhen": "обращение решено и окно подтверждения истекло, отклонено или закрыто без ответа",
    "inScope": [
      "разбор обращения",
      "работа по обращению",
      "уточнение у заявителя",
      "окно подтверждения после решения"
    ],
    "outOfScope": [
      "переписка по существу",
      "конвертация в задачу"
    ]
  },
  "roles": [
    {
      "id": "support_agent",
      "name": "Агент поддержки",
      "kind": "human",
      "responsibilities": [
        "разбор обращений"
      ],
      "capability": "support.handle",
      "scopeField": "target_group_id"
    },
    {
      "id": "requester",
      "name": "Заявитель",
      "kind": "human",
      "responsibilities": [
        "подача обращения"
      ]
    }
  ],
  "data": [],
  "rules": [],
  "elements": {
    "__start__": {
      "type": "startEvent",
      "description": "Обращение создано"
    },
    "triage": {
      "type": "userTask",
      "name": "Разбор обращения",
      "description": "Принять в работу, отклонить или уточнить детали",
      "assignedRole": "support_agent",
      "timing": {
        "sla": 8,
        "reminder": 4
      },
      "decisions": [
        {
          "id": "accept",
          "label": "Принять"
        },
        {
          "id": "decline",
          "label": "Отклонить"
        },
        {
          "id": "needs_info",
          "label": "Нужна информация"
        }
      ],
      "workDistribution": {
        "performedBy": "human"
      }
    },
    "awaiting_info": {
      "type": "intermediateCatchEvent",
      "name": "Ждём ответ заявителя",
      "description": "Заявитель должен уточнить детали обращения",
      "timing": {
        "deadline": 72
      },
      "eventType": "message"
    },
    "working": {
      "type": "userTask",
      "name": "Работа по обращению",
      "description": "Решить обращение или отклонить",
      "assignedRole": "support_agent",
      "timing": {
        "sla": 24,
        "reminder": 12
      },
      "decisions": [
        {
          "id": "resolve",
          "label": "Решено"
        },
        {
          "id": "decline",
          "label": "Отклонить"
        }
      ],
      "workDistribution": {
        "performedBy": "human"
      }
    },
    "resolved": {
      "type": "endEvent",
      "name": "Решено",
      "description": "Обращение решено",
      "final": true
    },
    "declined": {
      "type": "endEvent",
      "name": "Отклонено",
      "description": "Обращение отклонено",
      "final": true
    },
    "closed": {
      "type": "endEvent",
      "name": "Закрыто",
      "description": "Ответа не было, обращение закрыто",
      "final": true
    },
    "after_triage": {
      "type": "exclusiveGateway",
      "name": "Что делаем с обращением?"
    },
    "after_work": {
      "type": "exclusiveGateway",
      "name": "Обращение решено?"
    },
    "awaiting_confirmation": {
      "type": "intermediateCatchEvent",
      "name": "Ждём подтверждения заявителя",
      "description": "Заявитель может ответить — обращение вернётся в работу; молчание закрывает окно",
      "assignedRole": "requester",
      "timing": {
        "deadline": 120
      },
      "eventType": "message"
    }
  },
  "transitions": [
    {
      "id": "tr_created",
      "from": "__start__",
      "to": "triage",
      "on": {
        "event": "SupportRequestCreated"
      },
      "journal": [
        "timestamp",
        "event"
      ],
      "description": "Новое обращение поступило на разбор"
    },
    {
      "id": "tr_reopen",
      "from": "__start__",
      "to": "triage",
      "on": {
        "event": "SupportRequestReopened"
      },
      "journal": [
        "timestamp",
        "event"
      ],
      "description": "Заявитель ответил в закрытом обращении — новый разбор"
    },
    {
      "id": "tr_decide",
      "from": "triage",
      "to": "after_triage",
      "journal": [
        "timestamp",
        "actor",
        "decision"
      ],
      "description": "Агент принял решение, переходим к развилке"
    },
    {
      "id": "tr_accept",
      "from": "after_triage",
      "to": "working",
      "condition": {
        "all": [
          {
            "field": "last_decision",
            "op": "==",
            "value": "accept"
          }
        ]
      },
      "actions": [
        {
          "action": "support_change_status",
          "args": {
            "request_id": "${context_id}",
            "status": "accepted",
            "via_process": true
          }
        },
        {
          "action": "support_claim_request",
          "args": {
            "request_id": "${context_id}"
          }
        },
        {
          "action": "support_change_status",
          "args": {
            "request_id": "${context_id}",
            "status": "in_progress",
            "via_process": true
          }
        }
      ],
      "journal": [
        "timestamp",
        "actor",
        "decision",
        "action"
      ]
    },
    {
      "id": "tr_decline",
      "from": "after_triage",
      "to": "declined",
      "condition": {
        "all": [
          {
            "field": "last_decision",
            "op": "==",
            "value": "decline"
          }
        ]
      },
      "actions": [
        {
          "action": "support_change_status",
          "args": {
            "request_id": "${context_id}",
            "status": "declined",
            "via_process": true
          }
        }
      ],
      "journal": [
        "timestamp",
        "actor",
        "decision",
        "action"
      ]
    },
    {
      "id": "tr_needs_info",
      "from": "after_triage",
      "to": "awaiting_info",
      "condition": {
        "all": [
          {
            "field": "last_decision",
            "op": "==",
            "value": "needs_info"
          }
        ]
      },
      "actions": [
        {
          "action": "support_change_status",
          "args": {
            "request_id": "${context_id}",
            "status": "needs_info",
            "via_process": true
          }
        }
      ],
      "journal": [
        "timestamp",
        "actor",
        "decision",
        "action"
      ]
    },
    {
      "id": "tr_reply",
      "from": "awaiting_info",
      "to": "working",
      "on": {
        "event": "SupportRequestMessageAdded"
      },
      "actorMode": "system",
      "condition": {
        "all": [
          {
            "field": "event.payload.author_id",
            "op": "==",
            "value": "${author_id}"
          },
          {
            "field": "event.aggregate_id",
            "op": "==",
            "value": "${context_id}"
          }
        ]
      },
      "actions": [
        {
          "action": "support_change_status",
          "args": {
            "request_id": "${context_id}",
            "status": "accepted",
            "via_process": true
          }
        }
      ],
      "journal": [
        "timestamp",
        "event",
        "action"
      ],
      "description": "Заявитель ответил — обращение возвращается в работу"
    },
    {
      "id": "tr_no_reply",
      "from": "awaiting_info",
      "to": "closed",
      "on": {
        "timer": "timer_awaiting_reply"
      },
      "actorMode": "system",
      "actions": [
        {
          "action": "support_change_status",
          "args": {
            "request_id": "${context_id}",
            "status": "closed",
            "via_process": true
          }
        }
      ],
      "journal": [
        "timestamp",
        "timer",
        "action"
      ],
      "description": "Заявитель не ответил — обращение закрыто"
    },
    {
      "id": "tr_work",
      "from": "working",
      "to": "after_work",
      "journal": [
        "timestamp",
        "actor",
        "decision"
      ],
      "description": "Работа завершена решением, переходим к развилке"
    },
    {
      "id": "tr_resolve",
      "from": "after_work",
      "to": "awaiting_confirmation",
      "condition": {
        "all": [
          {
            "field": "last_decision",
            "op": "==",
            "value": "resolve"
          }
        ]
      },
      "actions": [
        {
          "action": "support_change_status",
          "args": {
            "request_id": "${context_id}",
            "status": "resolved",
            "via_process": true
          }
        }
      ],
      "journal": [
        "timestamp",
        "actor",
        "decision",
        "action"
      ],
      "description": "Решение принято — открывается окно подтверждения заявителя"
    },
    {
      "id": "tr_confirm_reopen",
      "from": "awaiting_confirmation",
      "to": "working",
      "on": {
        "event": "SupportRequestReopened"
      },
      "actorMode": "system",
      "condition": {
        "all": [
          {
            "field": "event.payload.author_id",
            "op": "==",
            "value": "${author_id}"
          },
          {
            "field": "event.aggregate_id",
            "op": "==",
            "value": "${context_id}"
          }
        ]
      },
      "journal": [
        "timestamp",
        "event"
      ],
      "description": "Заявитель не согласен — обращение возвращается в работу без нового экземпляра"
    },
    {
      "id": "tr_confirm_timeout",
      "from": "awaiting_confirmation",
      "to": "resolved",
      "on": {
        "timer": "timer_confirmation"
      },
      "actorMode": "system",
      "journal": [
        "timestamp",
        "timer"
      ],
      "description": "Заявитель промолчал — решение считается подтверждённым"
    },
    {
      "id": "tr_work_decline",
      "from": "after_work",
      "to": "declined",
      "condition": {
        "all": [
          {
            "field": "last_decision",
            "op": "==",
            "value": "decline"
          }
        ]
      },
      "actions": [
        {
          "action": "support_change_status",
          "args": {
            "request_id": "${context_id}",
            "status": "declined",
            "via_process": true
          }
        }
      ],
      "journal": [
        "timestamp",
        "actor",
        "decision",
        "action"
      ]
    }
  ],
  "timers": [
    {
      "id": "timer_awaiting_reply",
      "state": "awaiting_info",
      "at": "${state_deadline}"
    },
    {
      "id": "timer_confirmation",
      "state": "awaiting_confirmation",
      "at": "${state_deadline}"
    }
  ],
  "tests": [
    {
      "id": "t_accept",
      "description": "Принятие переводит обращение в работу",
      "given": {},
      "when": [
        {
          "event": "SupportRequestCreated",
          "aggregate_id": "request-1",
          "payload": {
            "title": "Не работает вход"
          }
        },
        {
          "decision": "accept",
          "actor": "agent-1"
        }
      ],
      "then": {
        "state": "working",
        "status": "awaiting_user"
      }
    },
    {
      "id": "t_resolve",
      "description": "Решение открывает окно подтверждения, а не закрывает обращение",
      "given": {},
      "when": [
        {
          "event": "SupportRequestCreated",
          "aggregate_id": "request-1",
          "payload": {
            "title": "Не работает вход"
          }
        },
        {
          "decision": "accept",
          "actor": "agent-1"
        },
        {
          "decision": "resolve",
          "actor": "agent-1"
        }
      ],
      "then": {
        "state": "awaiting_confirmation",
        "status": "active"
      }
    },
    {
      "id": "t_decline",
      "description": "Отклонение на разборе завершает процесс",
      "given": {},
      "when": [
        {
          "event": "SupportRequestCreated",
          "aggregate_id": "request-1",
          "payload": {
            "title": "Не работает вход"
          }
        },
        {
          "decision": "decline",
          "actor": "agent-1"
        }
      ],
      "then": {
        "state": "declined",
        "status": "completed"
      }
    },
    {
      "id": "t_needs_info",
      "description": "Запрос информации переводит обращение в ожидание",
      "given": {},
      "when": [
        {
          "event": "SupportRequestCreated",
          "aggregate_id": "request-1",
          "payload": {
            "title": "Не работает вход",
            "author_id": "author-1"
          }
        },
        {
          "decision": "needs_info",
          "actor": "agent-1"
        }
      ],
      "then": {
        "state": "awaiting_info",
        "status": "active"
      }
    },
    {
      "id": "t_confirm_reopen",
      "description": "Ответ заявителя возвращает обращение в работу в том же экземпляре",
      "given": {
        "author_id": "author-1"
      },
      "when": [
        {
          "event": "SupportRequestCreated",
          "aggregate_id": "request-1",
          "payload": {
            "title": "Не работает вход",
            "author_id": "author-1"
          }
        },
        {
          "decision": "accept",
          "actor": "agent-1"
        },
        {
          "decision": "resolve",
          "actor": "agent-1"
        },
        {
          "event": "SupportRequestReopened",
          "aggregate_id": "request-1",
          "payload": {
            "author_id": "author-1"
          }
        }
      ],
      "then": {
        "state": "working",
        "status": "awaiting_user"
      }
    },
    {
      "id": "t_confirm_silence",
      "description": "Молчание в окне подтверждения завершает процесс решением",
      "given": {
        "author_id": "author-1"
      },
      "when": [
        {
          "event": "SupportRequestCreated",
          "aggregate_id": "request-1",
          "payload": {
            "title": "Не работает вход",
            "author_id": "author-1"
          }
        },
        {
          "decision": "accept",
          "actor": "agent-1"
        },
        {
          "decision": "resolve",
          "actor": "agent-1"
        },
        {
          "timer": "timer_confirmation"
        }
      ],
      "then": {
        "state": "resolved",
        "status": "completed"
      }
    }
  ],
  "audit": {
    "include": [
      "actor",
      "decision",
      "timestamp",
      "event"
    ]
  }
}
