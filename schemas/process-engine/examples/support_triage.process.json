{
  "schemaVersion": "0.2",
  "id": "support.triage",
  "name": "Разбор обращения",
  "description": "Разбор обращения и работа по нему: принять, отклонить или решить. Остальные переходы статусов выполняются в домене.",
  "version": "2026-10-30.3",
  "contextType": "support_request",
  "host": {
    "module": "support",
    "stateMap": {
      "new": "triage"
    },
    "contextUrl": "/community/{community}/support/{id}"
  },
  "passport": {
    "owner": "support_agent",
    "goal": "Разобрать обращение и довести до решения",
    "startsWhen": "обращение создано",
    "endsWhen": "обращение решено или отклонено",
    "inScope": [
      "разбор обращения",
      "работа по обращению"
    ],
    "outOfScope": [
      "переписка с заявителем",
      "решение по существу"
    ]
  },
  "roles": [
    {
      "id": "support_agent",
      "name": "Агент поддержки",
      "kind": "human",
      "responsibilities": [
        "разбор обращений"
      ],
      "capability": "support.handle",
      "scopeField": "target_group_id"
    },
    {
      "id": "requester",
      "name": "Заявитель",
      "kind": "human",
      "responsibilities": [
        "подача обращения"
      ]
    }
  ],
  "data": [],
  "rules": [],
  "states": {
    "__start__": {
      "type": "start_event",
      "description": "Обращение создано"
    },
    "triage": {
      "type": "user_task",
      "name": "Разбор обращения",
      "description": "Принять в работу или отклонить",
      "assignedRole": "support_agent",
      "slaHours": 8,
      "reminderHours": 4,
      "decisions": [
        {
          "id": "accept",
          "label": "Принять"
        },
        {
          "id": "decline",
          "label": "Отклонить"
        }
      ],
      "workDistribution": {
        "performedBy": "human"
      }
    },
    "working": {
      "type": "user_task",
      "name": "Работа по обращению",
      "description": "Решить обращение или отклонить",
      "assignedRole": "support_agent",
      "slaHours": 24,
      "reminderHours": 12,
      "decisions": [
        {
          "id": "resolve",
          "label": "Решено"
        },
        {
          "id": "decline",
          "label": "Отклонить"
        }
      ],
      "workDistribution": {
        "performedBy": "human"
      }
    },
    "resolved": {
      "type": "end_event",
      "name": "Решено",
      "final": true
    },
    "declined": {
      "type": "end_event",
      "name": "Отклонено",
      "final": true
    }
  },
  "gateways": {},
  "transitions": [
    {
      "id": "tr_created",
      "from": "__start__",
      "to": "triage",
      "on": {
        "event": "SupportRequestCreated"
      },
      "journal": [
        "timestamp",
        "event"
      ],
      "description": "Новое обращение поступило на разбор"
    },
    {
      "id": "tr_accept",
      "from": "triage",
      "to": "working",
      "on": {
        "decision": "accept"
      },
      "action": "support_change_status",
      "args": {
        "request_id": "${context_id}",
        "status": "accepted",
        "via_process": true
      },
      "journal": [
        "timestamp",
        "actor",
        "decision",
        "action"
      ]
    },
    {
      "id": "tr_triage_decline",
      "from": "triage",
      "to": "declined",
      "on": {
        "decision": "decline"
      },
      "action": "support_change_status",
      "args": {
        "request_id": "${context_id}",
        "status": "declined",
        "via_process": true
      },
      "journal": [
        "timestamp",
        "actor",
        "decision",
        "action"
      ]
    },
    {
      "id": "tr_resolve",
      "from": "working",
      "to": "resolved",
      "on": {
        "decision": "resolve"
      },
      "action": "support_change_status",
      "args": {
        "request_id": "${context_id}",
        "status": "resolved",
        "via_process": true
      },
      "journal": [
        "timestamp",
        "actor",
        "decision",
        "action"
      ]
    },
    {
      "id": "tr_work_decline",
      "from": "working",
      "to": "declined",
      "on": {
        "decision": "decline"
      },
      "action": "support_change_status",
      "args": {
        "request_id": "${context_id}",
        "status": "declined",
        "via_process": true
      },
      "journal": [
        "timestamp",
        "actor",
        "decision",
        "action"
      ]
    }
  ],
  "timers": [],
  "tests": [
    {
      "id": "t_accept",
      "description": "Принятие переводит обращение в работу",
      "given": {},
      "when": [
        {
          "event": "SupportRequestCreated",
          "aggregate_id": "request-1",
          "payload": {
            "title": "Не работает вход"
          }
        },
        {
          "decision": "accept",
          "actor": "agent-1"
        }
      ],
      "then": {
        "state": "working",
        "status": "awaiting_user"
      }
    },
    {
      "id": "t_resolve",
      "description": "Решение закрывает обращение",
      "given": {},
      "when": [
        {
          "event": "SupportRequestCreated",
          "aggregate_id": "request-1",
          "payload": {
            "title": "Не работает вход"
          }
        },
        {
          "decision": "accept",
          "actor": "agent-1"
        },
        {
          "decision": "resolve",
          "actor": "agent-1"
        }
      ],
      "then": {
        "state": "resolved",
        "status": "completed"
      }
    },
    {
      "id": "t_decline",
      "description": "Отклонение на разборе завершает процесс",
      "given": {},
      "when": [
        {
          "event": "SupportRequestCreated",
          "aggregate_id": "request-1",
          "payload": {
            "title": "Не работает вход"
          }
        },
        {
          "decision": "decline",
          "actor": "agent-1"
        }
      ],
      "then": {
        "state": "declined",
        "status": "completed"
      }
    }
  ],
  "audit": {
    "include": [
      "actor",
      "decision",
      "timestamp",
      "event"
    ]
  }
}
