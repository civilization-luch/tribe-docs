{
  "schemaVersion": "0.2",
  "id": "support.triage",
  "name": "Разбор обращения",
  "description": "Первичный разбор обращения в поддержку: принять в работу или отклонить. Дальнейшая работа с обращением ведётся в домене.",
  "version": "2026-10-30.3",
  "contextType": "support_request",
  "host": {
    "module": "support",
    "stateMap": {
      "new": "triage"
    },
    "contextUrl": "/community/{community}/support/{id}"
  },
  "passport": {
    "owner": "support_agent",
    "goal": "Разобрать новое обращение: принять в работу или отклонить",
    "startsWhen": "обращение создано",
    "endsWhen": "обращение принято в работу или отклонено",
    "inScope": [
      "первичный разбор обращения"
    ],
    "outOfScope": [
      "переписка с заявителем",
      "решение по существу"
    ]
  },
  "roles": [
    {
      "id": "support_agent",
      "name": "Агент поддержки",
      "kind": "human",
      "responsibilities": [
        "разбор обращений"
      ],
      "capability": "support.handle",
      "scopeField": "target_group_id"
    },
    {
      "id": "requester",
      "name": "Заявитель",
      "kind": "human",
      "responsibilities": [
        "подача обращения"
      ]
    }
  ],
  "data": [],
  "rules": [],
  "states": {
    "__start__": {
      "type": "start_event",
      "description": "Обращение создано"
    },
    "triage": {
      "type": "user_task",
      "name": "Разбор обращения",
      "description": "Принять обращение в работу или отклонить",
      "assignedRole": "support_agent",
      "slaHours": 8,
      "reminderHours": 4,
      "workDistribution": {
        "performedBy": "human"
      }
    },
    "triaged": {
      "type": "end_event",
      "name": "Принято",
      "description": "Обращение принято в работу",
      "final": true
    },
    "declined": {
      "type": "end_event",
      "name": "Отклонено",
      "description": "Обращение отклонено без работы",
      "final": true
    }
  },
  "gateways": {},
  "transitions": [
    {
      "id": "tr_created",
      "from": "__start__",
      "to": "triage",
      "on": {
        "event": "SupportRequestCreated"
      },
      "journal": [
        "timestamp",
        "event"
      ],
      "description": "Новое обращение поступило на разбор"
    },
    {
      "id": "tr_accept",
      "from": "triage",
      "to": "triaged",
      "on": {
        "decision": "accept"
      },
      "action": "support_change_status",
      "args": {
        "request_id": "${context_id}",
        "status": "triaged",
        "via_process": true
      },
      "journal": [
        "timestamp",
        "actor",
        "decision",
        "action"
      ],
      "description": "Принять обращение в работу"
    },
    {
      "id": "tr_decline",
      "from": "triage",
      "to": "declined",
      "on": {
        "decision": "decline"
      },
      "action": "support_change_status",
      "args": {
        "request_id": "${context_id}",
        "status": "declined",
        "via_process": true
      },
      "journal": [
        "timestamp",
        "actor",
        "decision",
        "action"
      ],
      "description": "Отклонить обращение"
    }
  ],
  "timers": [],
  "tests": [
    {
      "id": "t_accept",
      "description": "Принятие переводит обращение в triaged",
      "given": {},
      "when": [
        {
          "event": "SupportRequestCreated",
          "aggregate_id": "request-1",
          "payload": {
            "title": "Не работает вход"
          }
        },
        {
          "decision": "accept",
          "actor": "admin-1"
        }
      ],
      "then": {
        "state": "triaged",
        "status": "completed"
      }
    },
    {
      "id": "t_decline",
      "description": "Отклонение переводит обращение в declined",
      "given": {},
      "when": [
        {
          "event": "SupportRequestCreated",
          "aggregate_id": "request-1",
          "payload": {
            "title": "Не работает вход"
          }
        },
        {
          "decision": "decline",
          "actor": "admin-1"
        }
      ],
      "then": {
        "state": "declined",
        "status": "completed"
      }
    }
  ],
  "audit": {
    "include": [
      "actor",
      "decision",
      "timestamp",
      "event"
    ]
  }
}
