{
  "schemaVersion": "0.2",
  "id": "support.triage",
  "name": "Разбор обращения",
  "description": "Разбор обращения и работа по нему: принять, отклонить или решить. Остальные переходы статусов выполняются в домене.",
  "version": "2026-10-30.3",
  "contextType": "support_request",
  "host": {
    "module": "support",
    "stateMap": {
      "new": "triage"
    },
    "contextUrl": "/community/{community}/support/{id}"
  },
  "passport": {
    "owner": "support_agent",
    "goal": "Разобрать обращение и довести до решения",
    "startsWhen": "обращение создано",
    "endsWhen": "обращение решено или отклонено",
    "inScope": [
      "разбор обращения",
      "работа по обращению",
      "уточнение у заявителя"
    ],
    "outOfScope": [
      "переписка с заявителем",
      "решение по существу"
    ]
  },
  "roles": [
    {
      "id": "support_agent",
      "name": "Агент поддержки",
      "kind": "human",
      "responsibilities": [
        "разбор обращений"
      ],
      "capability": "support.handle",
      "scopeField": "target_group_id"
    },
    {
      "id": "requester",
      "name": "Заявитель",
      "kind": "human",
      "responsibilities": [
        "подача обращения"
      ]
    }
  ],
  "data": [],
  "rules": [],
  "states": {
    "__start__": {
      "type": "start_event",
      "description": "Обращение создано"
    },
    "triage": {
      "type": "user_task",
      "name": "Разбор обращения",
      "description": "Принять в работу или отклонить",
      "assignedRole": "support_agent",
      "slaHours": 8,
      "reminderHours": 4,
      "decisions": [
        {
          "id": "accept",
          "label": "Принять"
        },
        {
          "id": "needs_info",
          "label": "Нужна информация"
        },
        {
          "id": "decline",
          "label": "Отклонить"
        }
      ],
      "workDistribution": {
        "performedBy": "human"
      }
    },
    "awaiting_info": {
      "type": "wait",
      "name": "Ждём ответ заявителя",
      "description": "Заявитель должен уточнить детали обращения",
      "deadlineHours": 72
    },
    "working": {
      "type": "user_task",
      "name": "Работа по обращению",
      "description": "Решить обращение или отклонить",
      "assignedRole": "support_agent",
      "slaHours": 24,
      "reminderHours": 12,
      "decisions": [
        {
          "id": "resolve",
          "label": "Решено"
        },
        {
          "id": "decline",
          "label": "Отклонить"
        }
      ],
      "workDistribution": {
        "performedBy": "human"
      }
    },
    "resolved": {
      "type": "end_event",
      "name": "Решено",
      "final": true
    },
    "declined": {
      "type": "end_event",
      "name": "Отклонено",
      "final": true
    },
    "closed": {
      "type": "end_event",
      "name": "Закрыто",
      "description": "Ответа не было, обращение закрыто",
      "final": true
    }
  },
  "gateways": {},
  "transitions": [
    {
      "id": "tr_created",
      "from": "__start__",
      "to": "triage",
      "on": {
        "event": "SupportRequestCreated"
      },
      "journal": [
        "timestamp",
        "event"
      ],
      "description": "Новое обращение поступило на разбор"
    },
    {
      "id": "tr_accept",
      "from": "triage",
      "to": "working",
      "on": {
        "decision": "accept"
      },
      "journal": [
        "timestamp",
        "actor",
        "decision",
        "action"
      ],
      "actions": [
        {
          "action": "support_change_status",
          "args": {
            "request_id": "${context_id}",
            "status": "accepted",
            "via_process": true
          }
        },
        {
          "action": "support_claim_request",
          "args": {
            "request_id": "${context_id}"
          }
        },
        {
          "action": "support_change_status",
          "args": {
            "request_id": "${context_id}",
            "status": "in_progress",
            "via_process": true
          }
        }
      ]
    },
    {
      "id": "tr_needs_info",
      "from": "triage",
      "to": "awaiting_info",
      "on": {
        "decision": "needs_info"
      },
      "action": "support_change_status",
      "args": {
        "request_id": "${context_id}",
        "status": "needs_info",
        "via_process": true
      },
      "journal": [
        "timestamp",
        "actor",
        "decision",
        "action"
      ]
    },
    {
      "id": "tr_triage_decline",
      "from": "triage",
      "to": "declined",
      "on": {
        "decision": "decline"
      },
      "action": "support_change_status",
      "args": {
        "request_id": "${context_id}",
        "status": "declined",
        "via_process": true
      },
      "journal": [
        "timestamp",
        "actor",
        "decision",
        "action"
      ]
    },
    {
      "id": "tr_resolve",
      "from": "working",
      "to": "resolved",
      "on": {
        "decision": "resolve"
      },
      "action": "support_change_status",
      "args": {
        "request_id": "${context_id}",
        "status": "resolved",
        "via_process": true
      },
      "journal": [
        "timestamp",
        "actor",
        "decision",
        "action"
      ]
    },
    {
      "id": "tr_work_decline",
      "from": "working",
      "to": "declined",
      "on": {
        "decision": "decline"
      },
      "action": "support_change_status",
      "args": {
        "request_id": "${context_id}",
        "status": "declined",
        "via_process": true
      },
      "journal": [
        "timestamp",
        "actor",
        "decision",
        "action"
      ]
    },
    {
      "id": "tr_reply",
      "from": "awaiting_info",
      "to": "working",
      "on": {
        "event": "SupportRequestMessageAdded"
      },
      "condition": {
        "all": [
          {
            "field": "event.payload.author_id",
            "op": "==",
            "value": "${author_id}"
          }
        ]
      },
      "action": "support_change_status",
      "args": {
        "request_id": "${context_id}",
        "status": "accepted",
        "via_process": true
      },
      "journal": [
        "timestamp",
        "event",
        "action"
      ],
      "description": "Заявитель ответил — обращение возвращается в работу",
      "actor": "system"
    },
    {
      "id": "tr_no_reply",
      "from": "awaiting_info",
      "to": "closed",
      "on": {
        "timer": "timer_awaiting_reply"
      },
      "actor": "system",
      "action": "support_change_status",
      "args": {
        "request_id": "${context_id}",
        "status": "closed",
        "via_process": true
      },
      "journal": [
        "timestamp",
        "timer",
        "action"
      ],
      "description": "Заявитель не ответил — обращение закрыто"
    }
  ],
  "timers": [
    {
      "id": "timer_awaiting_reply",
      "state": "awaiting_info",
      "at": "${state_deadline}"
    }
  ],
  "tests": [
    {
      "id": "t_accept",
      "description": "Принятие переводит обращение в работу",
      "given": {},
      "when": [
        {
          "event": "SupportRequestCreated",
          "aggregate_id": "request-1",
          "payload": {
            "title": "Не работает вход"
          }
        },
        {
          "decision": "accept",
          "actor": "agent-1"
        }
      ],
      "then": {
        "state": "working",
        "status": "awaiting_user"
      }
    },
    {
      "id": "t_resolve",
      "description": "Решение закрывает обращение",
      "given": {},
      "when": [
        {
          "event": "SupportRequestCreated",
          "aggregate_id": "request-1",
          "payload": {
            "title": "Не работает вход"
          }
        },
        {
          "decision": "accept",
          "actor": "agent-1"
        },
        {
          "decision": "resolve",
          "actor": "agent-1"
        }
      ],
      "then": {
        "state": "resolved",
        "status": "completed"
      }
    },
    {
      "id": "t_decline",
      "description": "Отклонение на разборе завершает процесс",
      "given": {},
      "when": [
        {
          "event": "SupportRequestCreated",
          "aggregate_id": "request-1",
          "payload": {
            "title": "Не работает вход"
          }
        },
        {
          "decision": "decline",
          "actor": "agent-1"
        }
      ],
      "then": {
        "state": "declined",
        "status": "completed"
      }
    },
    {
      "id": "t_needs_info",
      "description": "Запрос информации переводит обращение в ожидание",
      "given": {},
      "when": [
        {
          "event": "SupportRequestCreated",
          "aggregate_id": "request-1",
          "payload": {
            "title": "Не работает вход",
            "author_id": "author-1"
          }
        },
        {
          "decision": "needs_info",
          "actor": "agent-1"
        }
      ],
      "then": {
        "state": "awaiting_info",
        "status": "active"
      }
    }
  ],
  "audit": {
    "include": [
      "actor",
      "decision",
      "timestamp",
      "event"
    ]
  }
}
