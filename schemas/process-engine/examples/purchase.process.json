{
  "schemaVersion": "0.4",
  "id": "guarantee.purchase",
  "name": "Закупка (Purchase)",
  "description": "Жизненный цикл совместной закупки: сбор заявок до дедлайна, готовность при достижении минимума, запуск организатором или истечение, затем исполнение сделок участников до закрытия. Точки ожидания — событийные развилки.",
  "version": "2026-11-01",
  "contextType": "ge_purchase",
  "host": {
    "module": "guarantee"
  },
  "passport": {
    "owner": "organizer",
    "goal": "Собрать заявки до минимума и запустить закупку в срок",
    "startsWhen": "организатор создал закупку",
    "endsWhen": "закупка истекла, отменена, не запустилась или все её сделки закрыты",
    "inScope": [
      "сбор заявок",
      "достижение минимума",
      "запуск",
      "истечение",
      "отмена",
      "сопровождение исполнения"
    ],
    "outOfScope": [
      "условия сделки",
      "доставка",
      "расчёты с поставщиком"
    ],
    "successMetrics": [
      {
        "name": "доля закупок, достигших минимума",
        "target": ">= 50%",
        "unit": "процент"
      },
      {
        "name": "время до запуска",
        "target": "<= join_deadline",
        "unit": "дни"
      }
    ]
  },
  "roles": [
    {
      "id": "organizer",
      "name": "Организатор",
      "kind": "human",
      "responsibilities": [
        "создание закупки",
        "запуск",
        "отмена"
      ]
    },
    {
      "id": "member",
      "name": "Участник",
      "kind": "human",
      "responsibilities": [
        "подача и отзыв заявки"
      ]
    },
    {
      "id": "system",
      "name": "Система",
      "kind": "system",
      "responsibilities": [
        "таймеры",
        "подсчёт собранной суммы"
      ]
    }
  ],
  "data": [
    {
      "id": "collected",
      "type": "number",
      "required": true,
      "source": "sum(submitted applications)"
    },
    {
      "id": "min_total",
      "type": "number",
      "required": true,
      "source": "purchase.min_total"
    },
    {
      "id": "max_total",
      "type": "number",
      "required": false,
      "source": "purchase.max_total"
    },
    {
      "id": "max_per_member",
      "type": "number",
      "required": false,
      "source": "purchase.max_per_member"
    },
    {
      "id": "join_deadline",
      "type": "datetime",
      "required": true,
      "source": "purchase.join_deadline"
    },
    {
      "id": "delivery_covered",
      "type": "boolean",
      "required": false,
      "source": "delivery deal coverage"
    },
    {
      "id": "deals_total",
      "type": "number",
      "required": true,
      "source": "count(deals of purchase)"
    },
    {
      "id": "deals_open",
      "type": "number",
      "required": true,
      "source": "count(deals not in completed/cancelled/resolved)"
    }
  ],
  "rules": [
    {
      "id": "br_min_collection",
      "name": "Минимум сбора",
      "type": "deterministic",
      "version": "2026-10-01",
      "source": "policy",
      "description": "Закупка готова к запуску, только если сумма поданных заявок не меньше min_total"
    }
  ],
  "elements": {
    "__start__": {
      "type": "startEvent",
      "description": "Закупка создана организатором"
    },
    "expired": {
      "type": "endEvent",
      "name": "Истекло",
      "description": "Дедлайн прошёл, минимум не собран; все заявки отменены",
      "final": true
    },
    "cancelled": {
      "type": "endEvent",
      "name": "Отменено",
      "description": "Отменено организатором; заявки и сделки отменены",
      "final": true
    },
    "closed": {
      "type": "endEvent",
      "name": "Закрыто",
      "description": "Все сделки закупки завершены, отменены или разрешены",
      "final": true
    },
    "collecting": {
      "type": "eventBasedGateway",
      "name": "Сбор заявок"
    },
    "after_deadline": {
      "type": "exclusiveGateway",
      "name": "Минимум набран?"
    },
    "ready": {
      "type": "eventBasedGateway",
      "name": "Набрано, ждём запуска",
      "assignedRole": "organizer"
    },
    "launched": {
      "type": "eventBasedGateway",
      "name": "Исполнение сделок",
      "assignedRole": "member"
    }
  },
  "transitions": [
    {
      "id": "tr_created",
      "from": "__start__",
      "to": "collecting",
      "on": {
        "event": "PurchaseCreated"
      },
      "label": "создание",
      "journal": [
        "timestamp",
        "event"
      ],
      "description": "Старт процесса при создании закупки"
    },
    {
      "id": "tr_deadline",
      "from": "collecting",
      "to": "after_deadline",
      "on": {
        "timer": "timer_join_deadline"
      },
      "label": "дедлайн",
      "journal": [
        "timestamp",
        "event"
      ],
      "description": "Дедлайн сбора: проверяем минимум"
    },
    {
      "id": "tr_launch_from_collecting",
      "from": "collecting",
      "to": "launched",
      "on": {
        "event": "PurchaseLaunched"
      },
      "role": "organizer",
      "label": "запуск",
      "actions": [
        {
          "action": "guarantee_launch_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "journal": [
        "timestamp",
        "event"
      ],
      "description": "Досрочный запуск организатором"
    },
    {
      "id": "tr_cancel_collecting",
      "from": "collecting",
      "to": "cancelled",
      "on": {
        "event": "PurchaseCancelled"
      },
      "role": "organizer",
      "label": "отмена",
      "actions": [
        {
          "action": "guarantee_cancel_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "journal": [
        "timestamp",
        "event"
      ],
      "description": "Отмена на этапе сбора"
    },
    {
      "id": "tr_ready_flow",
      "from": "after_deadline",
      "to": "ready",
      "label": "сумма ≥ минимума",
      "condition": {
        "all": [
          {
            "field": "collected",
            "op": ">=",
            "value": "${min_total}"
          }
        ]
      },
      "actions": [
        {
          "action": "guarantee_mark_purchase_ready",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "journal": [
        "timestamp",
        "event",
        "variables"
      ],
      "description": "Минимум собран — ждём запуска"
    },
    {
      "id": "tr_expire_flow",
      "from": "after_deadline",
      "to": "expired",
      "label": "сумма < минимума",
      "condition": {
        "all": [
          {
            "field": "collected",
            "op": "<",
            "value": "${min_total}"
          }
        ]
      },
      "actions": [
        {
          "action": "guarantee_expire_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "journal": [
        "timestamp",
        "event",
        "variables"
      ],
      "description": "Минимум не собран — закупка истекает"
    },
    {
      "id": "tr_launch_from_ready",
      "from": "ready",
      "to": "launched",
      "on": {
        "event": "PurchaseLaunched"
      },
      "role": "organizer",
      "label": "запуск",
      "actions": [
        {
          "action": "guarantee_launch_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "journal": [
        "timestamp",
        "event"
      ],
      "description": "Запуск после достижения минимума"
    },
    {
      "id": "tr_cancel_ready",
      "from": "ready",
      "to": "cancelled",
      "on": {
        "event": "PurchaseCancelled"
      },
      "role": "organizer",
      "label": "отмена",
      "actions": [
        {
          "action": "guarantee_cancel_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "journal": [
        "timestamp",
        "event"
      ],
      "description": "Отмена после достижения минимума"
    },
    {
      "id": "tr_no_deals",
      "from": "launched",
      "to": "closed",
      "label": "сделок нет",
      "condition": {
        "all": [
          {
            "field": "deals_open",
            "op": "==",
            "value": 0
          }
        ]
      },
      "actions": [
        {
          "action": "guarantee_close_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "journal": [
        "timestamp",
        "variables"
      ],
      "description": "Запуск без сделок — закрываем сразу"
    },
    {
      "id": "tr_deals_completed",
      "from": "launched",
      "to": "closed",
      "on": {
        "event": "DealCompleted"
      },
      "label": "сделка завершена",
      "condition": {
        "all": [
          {
            "field": "deals_open",
            "op": "==",
            "value": 0
          }
        ]
      },
      "actions": [
        {
          "action": "guarantee_close_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "journal": [
        "timestamp",
        "event"
      ],
      "description": "Завершена последняя сделка"
    },
    {
      "id": "tr_deals_cancelled",
      "from": "launched",
      "to": "closed",
      "on": {
        "event": "DealCancelled"
      },
      "label": "сделка отменена",
      "condition": {
        "all": [
          {
            "field": "deals_open",
            "op": "==",
            "value": 0
          }
        ]
      },
      "actions": [
        {
          "action": "guarantee_close_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "journal": [
        "timestamp",
        "event"
      ],
      "description": "Отменена последняя сделка"
    },
    {
      "id": "tr_deals_resolved",
      "from": "launched",
      "to": "closed",
      "on": {
        "event": "DealResolved"
      },
      "label": "спор решён",
      "condition": {
        "all": [
          {
            "field": "deals_open",
            "op": "==",
            "value": 0
          }
        ]
      },
      "actions": [
        {
          "action": "guarantee_close_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "journal": [
        "timestamp",
        "event"
      ],
      "description": "Разрешён последний спор"
    }
  ],
  "timers": [
    {
      "id": "timer_join_deadline",
      "state": "collecting",
      "at": "${join_deadline}"
    }
  ],
  "agent": {
    "knowledgeSources": [],
    "allowedStates": [
      "collecting",
      "ready",
      "launched"
    ],
    "stopConditions": [
      "нет данных о сумме заявок"
    ],
    "deny": [
      "guarantee_launch_purchase",
      "guarantee_cancel_purchase"
    ]
  },
  "tests": [
    {
      "id": "t_ready_on_minimum",
      "description": "Минимум собран — ждём запуска",
      "given": {
        "collected": 60000,
        "min_total": 50000
      },
      "when": [
        {
          "event": "PurchaseCreated"
        },
        {
          "timer": "timer_join_deadline"
        }
      ],
      "then": {
        "state": "ready",
        "status": "active"
      }
    },
    {
      "id": "t_expire_below_minimum",
      "description": "Минимум не собран — закупка истекает",
      "given": {
        "collected": 1000,
        "min_total": 50000
      },
      "when": [
        {
          "event": "PurchaseCreated"
        },
        {
          "timer": "timer_join_deadline"
        }
      ],
      "then": {
        "state": "expired",
        "status": "completed"
      }
    },
    {
      "id": "t_launch_from_ready",
      "description": "Запуск подтверждён — исполнение сделок",
      "given": {
        "collected": 60000,
        "min_total": 50000
      },
      "when": [
        {
          "event": "PurchaseCreated"
        },
        {
          "timer": "timer_join_deadline"
        },
        {
          "event": "PurchaseLaunched",
          "actor": "user-1"
        }
      ],
      "then": {
        "state": "launched",
        "status": "active"
      }
    },
    {
      "id": "t_closed_when_deals_done",
      "description": "Все сделки закрыты — закупка закрывается",
      "given": {
        "collected": 60000,
        "min_total": 50000,
        "deals_total": 2,
        "deals_open": 0
      },
      "when": [
        {
          "event": "PurchaseCreated"
        },
        {
          "timer": "timer_join_deadline"
        },
        {
          "event": "PurchaseLaunched",
          "actor": "user-1"
        },
        {
          "event": "DealCompleted",
          "aggregate_id": "deal-1"
        }
      ],
      "then": {
        "state": "closed",
        "status": "completed"
      }
    }
  ],
  "audit": {
    "include": [
      "actor",
      "decision",
      "timestamp",
      "event",
      "action",
      "variables"
    ]
  }
}
