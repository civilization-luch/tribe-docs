{
  "schemaVersion": "0.3",
  "id": "guarantee.purchase",
  "name": "Закупка (Purchase)",
  "description": "Жизненный цикл совместной закупки: сбор заявок до дедлайна, готовность при достижении минимума, запуск организатором или истечение, затем сопровождение сделок участников до их закрытия.",
  "version": "2026-10-30.2",
  "contextType": "ge_purchase",
  "host": {
    "module": "guarantee"
  },
  "passport": {
    "owner": "organizer",
    "goal": "Собрать заявки до минимума и запустить закупку в срок",
    "startsWhen": "организатор создал закупку",
    "endsWhen": "закупка истекла, отменена, не запустилась или все её сделки закрыты",
    "inScope": [
      "сбор заявок",
      "достижение минимума",
      "запуск",
      "истечение",
      "отмена",
      "сопровождение исполнения"
    ],
    "outOfScope": [
      "условия сделки",
      "доставка",
      "расчёты с поставщиком"
    ],
    "successMetrics": [
      {
        "name": "доля закупок, достигших минимума",
        "target": ">= 50%",
        "unit": "процент"
      },
      {
        "name": "время до запуска",
        "target": "<= join_deadline",
        "unit": "дни"
      }
    ]
  },
  "roles": [
    {
      "id": "organizer",
      "name": "Организатор",
      "kind": "human",
      "responsibilities": [
        "создание закупки",
        "запуск",
        "отмена"
      ]
    },
    {
      "id": "member",
      "name": "Участник",
      "kind": "human",
      "responsibilities": [
        "подача и отзыв заявки"
      ]
    },
    {
      "id": "system",
      "name": "Система",
      "kind": "system",
      "responsibilities": [
        "таймеры",
        "подсчёт собранной суммы"
      ]
    }
  ],
  "data": [
    {
      "id": "collected",
      "type": "number",
      "required": true,
      "source": "sum(submitted applications)"
    },
    {
      "id": "min_total",
      "type": "number",
      "required": true,
      "source": "purchase.min_total"
    },
    {
      "id": "max_total",
      "type": "number",
      "required": false,
      "source": "purchase.max_total"
    },
    {
      "id": "max_per_member",
      "type": "number",
      "required": false,
      "source": "purchase.max_per_member"
    },
    {
      "id": "join_deadline",
      "type": "datetime",
      "required": true,
      "source": "purchase.join_deadline"
    },
    {
      "id": "delivery_covered",
      "type": "boolean",
      "required": false,
      "source": "delivery deal coverage"
    },
    {
      "id": "deals_total",
      "type": "number",
      "required": true,
      "source": "count(deals of purchase)"
    },
    {
      "id": "deals_open",
      "type": "number",
      "required": true,
      "source": "count(deals not in completed/cancelled/resolved)"
    }
  ],
  "rules": [
    {
      "id": "br_min_collection",
      "name": "Минимум сбора",
      "type": "deterministic",
      "version": "2026-10-01",
      "source": "policy",
      "description": "Закупка готова к запуску, только если сумма поданных заявок не меньше min_total"
    }
  ],
  "states": {
    "__start__": {
      "type": "start_event",
      "description": "Закупка создана организатором"
    },
    "collecting": {
      "type": "wait",
      "name": "Сбор заявок",
      "description": "Принимаются заявки участников до join_deadline",
      "workDistribution": {
        "performedBy": "system"
      }
    },
    "ready": {
      "type": "wait",
      "name": "Набрано, ждём запуска",
      "description": "Минимум собран; организатор должен запустить закупку или отменить её",
      "workDistribution": {
        "performedBy": "system"
      },
      "assignedRole": "organizer"
    },
    "launched": {
      "type": "wait",
      "name": "Исполнение сделок",
      "description": "Сделки созданы; ждём, пока участники и поставщик закроют их — завершением, отменой или спором",
      "workDistribution": {
        "performedBy": "system"
      },
      "assignedRole": "member"
    },
    "expired": {
      "type": "end_event",
      "name": "Истекло",
      "description": "Дедлайн прошёл, минимум не собран; все заявки отменены",
      "final": true,
      "workDistribution": {
        "performedBy": "system"
      }
    },
    "cancelled": {
      "type": "end_event",
      "name": "Отменено",
      "description": "Отменено организатором; заявки и сделки отменены",
      "final": true,
      "workDistribution": {
        "performedBy": "human",
        "approvalRequired": true
      }
    },
    "closed": {
      "type": "end_event",
      "name": "Закрыто",
      "description": "Все сделки закупки завершены, отменены или разрешены",
      "final": true,
      "workDistribution": {
        "performedBy": "system"
      }
    }
  },
  "transitions": [
    {
      "id": "tr_created",
      "from": "__start__",
      "to": "collecting",
      "on": {
        "event": "PurchaseCreated"
      },
      "journal": [
        "timestamp",
        "actor",
        "event"
      ],
      "description": "Старт процесса при создании закупки",
      "label": "создание"
    },
    {
      "id": "tr_ready",
      "from": "collecting",
      "to": "after_deadline",
      "ruleRefs": [
        "br_min_collection"
      ],
      "journal": [
        "timestamp",
        "event",
        "variables"
      ],
      "description": "Дедлайн прошёл — решаем по сумме",
      "on": {
        "timer": "timer_join_deadline"
      },
      "label": "дедлайн"
    },
    {
      "id": "tr_launch_from_collecting",
      "from": "collecting",
      "to": "launched",
      "on": {
        "event": "PurchaseLaunched"
      },
      "role": "organizer",
      "journal": [
        "timestamp",
        "actor",
        "event"
      ],
      "description": "Досрочный запуск организатором при выполненных условиях. Условия запуска проверяет домен, процесс фиксирует событие",
      "actions": [
        {
          "action": "guarantee_launch_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "label": "запуск"
    },
    {
      "id": "tr_launch_from_ready",
      "from": "ready",
      "to": "launched",
      "on": {
        "event": "PurchaseLaunched"
      },
      "role": "organizer",
      "journal": [
        "timestamp",
        "actor",
        "event"
      ],
      "description": "Запуск после достижения минимума. Условия запуска проверяет домен, процесс фиксирует событие",
      "actions": [
        {
          "action": "guarantee_launch_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "label": "запуск"
    },
    {
      "id": "tr_cancel_collecting",
      "from": "collecting",
      "to": "cancelled",
      "on": {
        "event": "PurchaseCancelled"
      },
      "role": "organizer",
      "journal": [
        "timestamp",
        "actor",
        "event"
      ],
      "description": "Отмена на этапе сбора",
      "actions": [
        {
          "action": "guarantee_cancel_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "label": "отмена"
    },
    {
      "id": "tr_cancel_ready",
      "from": "ready",
      "to": "cancelled",
      "on": {
        "event": "PurchaseCancelled"
      },
      "role": "organizer",
      "journal": [
        "timestamp",
        "actor",
        "event"
      ],
      "description": "Отмена после достижения минимума",
      "actions": [
        {
          "action": "guarantee_cancel_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "label": "отмена"
    },
    {
      "id": "tr_ready_flow",
      "from": "after_deadline",
      "to": "ready",
      "condition": {
        "all": [
          {
            "field": "collected",
            "op": ">=",
            "value": "${min_total}"
          }
        ]
      },
      "ruleRefs": [
        "br_min_collection"
      ],
      "actions": [
        {
          "action": "guarantee_mark_purchase_ready",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "journal": [
        "timestamp",
        "event",
        "variables"
      ],
      "label": "сумма ≥ минимума"
    },
    {
      "id": "tr_expire_flow",
      "from": "after_deadline",
      "to": "expired",
      "condition": {
        "all": [
          {
            "field": "collected",
            "op": "<",
            "value": "${min_total}"
          }
        ]
      },
      "ruleRefs": [
        "br_min_collection"
      ],
      "actions": [
        {
          "action": "guarantee_expire_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "journal": [
        "timestamp",
        "event",
        "variables"
      ],
      "label": "сумма < минимума"
    },
    {
      "id": "tr_no_deals",
      "from": "launched",
      "to": "closed",
      "condition": {
        "all": [
          {
            "field": "deals_open",
            "op": "==",
            "value": 0
          }
        ]
      },
      "journal": [
        "timestamp",
        "event",
        "variables"
      ],
      "description": "Закрываем закупку: все сделки уже закрыты на момент запуска",
      "actions": [
        {
          "action": "guarantee_close_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "label": "сделок нет"
    },
    {
      "id": "tr_deals_completed",
      "from": "launched",
      "to": "closed",
      "on": {
        "event": "DealCompleted"
      },
      "condition": {
        "all": [
          {
            "field": "deals_open",
            "op": "==",
            "value": 0
          }
        ]
      },
      "journal": [
        "timestamp",
        "event",
        "variables"
      ],
      "description": "Закрываем закупку: сделка завершена",
      "actions": [
        {
          "action": "guarantee_close_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "label": "сделка завершена"
    },
    {
      "id": "tr_deals_cancelled",
      "from": "launched",
      "to": "closed",
      "on": {
        "event": "DealCancelled"
      },
      "condition": {
        "all": [
          {
            "field": "deals_open",
            "op": "==",
            "value": 0
          }
        ]
      },
      "journal": [
        "timestamp",
        "event",
        "variables"
      ],
      "description": "Закрываем закупку: сделка отменена",
      "actions": [
        {
          "action": "guarantee_close_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "label": "сделка отменена"
    },
    {
      "id": "tr_deals_resolved",
      "from": "launched",
      "to": "closed",
      "on": {
        "event": "DealResolved"
      },
      "condition": {
        "all": [
          {
            "field": "deals_open",
            "op": "==",
            "value": 0
          }
        ]
      },
      "journal": [
        "timestamp",
        "event",
        "variables"
      ],
      "description": "Закрываем закупку: спор по сделке разрешён",
      "actions": [
        {
          "action": "guarantee_close_purchase",
          "args": {
            "purchase_id": "${context_id}"
          }
        }
      ],
      "label": "спор решён"
    }
  ],
  "timers": [
    {
      "id": "timer_join_deadline",
      "state": "collecting",
      "at": "${join_deadline}"
    }
  ],
  "forbidden": [
    {
      "id": "deny_expired_reopen",
      "from": "expired",
      "to": "collecting",
      "reason": "Дедлайн прошёл, сбор заявок закрыт безвозвратно"
    },
    {
      "id": "deny_expired_launch",
      "from": "expired",
      "to": "launched",
      "reason": "Нельзя запустить закупку, у которой истёк срок и не собран минимум"
    },
    {
      "id": "deny_cancelled_reopen",
      "from": "cancelled",
      "to": "collecting",
      "reason": "Отменённая закупка не возвращается в сбор"
    },
    {
      "id": "deny_cancelled_launch",
      "from": "cancelled",
      "to": "launched",
      "reason": "Отменённую закупку нельзя запустить"
    },
    {
      "id": "deny_launched_back",
      "from": "launched",
      "to": "collecting",
      "reason": "После запуска возврат в сбор невозможен"
    },
    {
      "id": "deny_launched_ready",
      "from": "launched",
      "to": "ready",
      "reason": "Запуск необратим в рамках этого процесса"
    },
    {
      "id": "deny_closed_back",
      "from": "closed",
      "to": "launched",
      "reason": "Закрытая закупка не возвращается в исполнение"
    }
  ],
  "agent": {
    "knowledgeSources": [],
    "allowedStates": [
      "collecting",
      "ready",
      "launched"
    ],
    "stopConditions": [
      "нет данных о сумме заявок"
    ],
    "deny": [
      "guarantee_launch_purchase",
      "guarantee_cancel_purchase"
    ]
  },
  "tests": [
    {
      "id": "t_ready_on_minimum",
      "description": "Минимум собран — переход в ready",
      "given": {
        "collected": 60000,
        "min_total": 50000,
        "delivery_covered": true
      },
      "when": [
        {
          "event": "PurchaseCreated"
        },
        {
          "timer": "timer_join_deadline"
        }
      ],
      "then": {
        "state": "ready",
        "status": "active"
      }
    },
    {
      "id": "t_expire_below_minimum",
      "description": "Минимум не собран — переход в expired",
      "given": {
        "collected": 1000,
        "min_total": 50000,
        "delivery_covered": true
      },
      "when": [
        {
          "event": "PurchaseCreated"
        },
        {
          "timer": "timer_join_deadline"
        }
      ],
      "then": {
        "state": "expired",
        "status": "completed"
      }
    },
    {
      "id": "t_launch_from_ready",
      "description": "Запуск подтверждён — закупка переходит к исполнению",
      "given": {
        "collected": 60000,
        "min_total": 50000,
        "delivery_covered": true
      },
      "when": [
        {
          "event": "PurchaseCreated"
        },
        {
          "timer": "timer_join_deadline"
        },
        {
          "event": "PurchaseLaunched",
          "actor": "user-1"
        }
      ],
      "then": {
        "state": "launched",
        "status": "active"
      }
    },
    {
      "id": "t_closed_when_deals_done",
      "description": "Все сделки закрыты — закупка закрывается",
      "given": {
        "collected": 60000,
        "min_total": 50000,
        "delivery_covered": true,
        "deals_total": 2,
        "deals_open": 0
      },
      "when": [
        {
          "event": "PurchaseCreated"
        },
        {
          "timer": "timer_join_deadline"
        },
        {
          "event": "PurchaseLaunched",
          "actor": "user-1"
        },
        {
          "event": "DealCompleted",
          "aggregate_id": "deal-1"
        }
      ],
      "then": {
        "state": "closed",
        "status": "completed"
      }
    }
  ],
  "audit": {
    "include": [
      "actor",
      "decision",
      "timestamp",
      "event",
      "action",
      "variables"
    ]
  },
  "gateways": {
    "after_deadline": {
      "type": "exclusive",
      "name": "Дедлайн сбора прошёл"
    }
  }
}
