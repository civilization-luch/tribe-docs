{
  "schemaVersion": "0.2",
  "id": "membership.onboarding",
  "name": "Онбординг участника",
  "description": "Заявка на вступление в сообщество: проверка администратором, развилка решения, одобрение или отказ. Простой пример процесса для знакомства с движком.",
  "version": "2026-10-30",
  "contextType": "member",
  "passport": {
    "owner": "admin",
    "goal": "Принять или отклонить заявку на вступление",
    "startsWhen": "участник подал заявку",
    "endsWhen": "заявка одобрена или отклонена",
    "inScope": ["рассмотрение заявки"],
    "outOfScope": ["онбординг после принятия"],
    "successMetrics": [
      { "name": "время рассмотрения", "target": "<= 24 ч", "unit": "часы" }
    ]
  },
  "roles": [
    {
      "id": "admin",
      "name": "Администратор",
      "kind": "human",
      "responsibilities": ["рассмотрение заявки"]
    },
    {
      "id": "applicant",
      "name": "Заявитель",
      "kind": "human",
      "responsibilities": ["подача заявки"]
    }
  ],
  "data": [],
  "rules": [],
  "states": {
    "__start__": {
      "type": "start_event",
      "description": "Заявка подана"
    },
    "review": {
      "type": "user_task",
      "name": "Проверка заявки",
      "description": "Администратор решает, принять участника или отказать",
      "assignedRole": "admin",
      "slaHours": 24,
      "workDistribution": { "performedBy": "human", "approvalRequired": true }
    },
    "approved": {
      "type": "end_event",
      "name": "Одобрено",
      "description": "Участник принят в сообщество",
      "final": true
    },
    "rejected": {
      "type": "end_event",
      "name": "Отклонено",
      "description": "Заявка отклонена",
      "final": true
    }
  },
  "gateways": {
    "decision": {
      "type": "exclusive"
    }
  },
  "transitions": [
    {
      "id": "tr_apply",
      "from": "__start__",
      "to": "review",
      "on": { "event": "MemberJoined" },
      "condition": {
        "all": [
          { "field": "event.payload.status", "op": "==", "value": "applicant" }
        ]
      },
      "journal": ["timestamp", "actor", "event"],
      "description": "Заявка поступила на рассмотрение"
    },
    {
      "id": "tr_decide",
      "from": "review",
      "to": "decision",
      "role": "admin",
      "journal": ["timestamp", "actor", "decision"],
      "description": "Администратор принял решение, переходим к развилке"
    },
    {
      "id": "tr_approve",
      "from": "decision",
      "to": "approved",
      "condition": {
        "all": [{ "field": "last_decision", "op": "==", "value": "approve" }]
      },
      "action": "membership_approve",
      "args": { "member_id": "${context_id}" },
      "journal": ["timestamp", "actor", "decision", "action"],
      "description": "Решение «одобрить» — участник принят"
    },
    {
      "id": "tr_reject",
      "from": "decision",
      "to": "rejected",
      "condition": {
        "all": [{ "field": "last_decision", "op": "==", "value": "reject" }]
      },
      "action": "membership_remove",
      "args": { "member_id": "${context_id}" },
      "journal": ["timestamp", "actor", "decision", "action"],
      "description": "Решение «отклонить» — заявка удалена"
    }
  ],
  "tests": [
    {
      "id": "t_approve",
      "description": "Одобрение ведёт в approved",
      "given": {},
      "when": [
        { "event": "MemberJoined", "aggregate_id": "member-1", "payload": { "status": "applicant" } },
        { "decision": "approve", "actor": "admin-1" }
      ],
      "then": { "state": "approved", "status": "completed" }
    },
    {
      "id": "t_reject",
      "description": "Отказ ведёт в rejected",
      "given": {},
      "when": [
        { "event": "MemberJoined", "aggregate_id": "member-1", "payload": { "status": "applicant" } },
        { "decision": "reject", "actor": "admin-1" }
      ],
      "then": { "state": "rejected", "status": "completed" }
    }
  ],
  "audit": {
    "include": ["actor", "decision", "timestamp", "event"]
  }
}
