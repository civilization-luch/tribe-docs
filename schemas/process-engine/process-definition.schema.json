{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tribe.partnr.icu/schemas/process-definition-0.1.json",
  "title": "Tribe Process Definition v0.1",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "contextType", "states", "transitions"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "contextType": { "type": "string" },
    "roles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "states": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": { "$ref": "#/$defs/state" }
    },
    "gateways": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/gateway" }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/transition" }
    },
    "timers": {
      "type": "array",
      "items": { "$ref": "#/$defs/timer" }
    },
    "forbidden": {
      "type": "array",
      "items": { "$ref": "#/$defs/forbiddenTransition" }
    },
    "audit": { "$ref": "#/$defs/audit" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "state": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["start_event", "end_event", "wait", "automated_task", "user_task"]
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "final": { "type": "boolean", "default": false },
        "action": { "type": "string" },
        "args": { "type": "object" },
        "assignedRole": { "type": "string" },
        "slaHours": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "gateway": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["exclusive", "parallel_fork", "parallel_join"] },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "requiredIncoming": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "onSuccess": { "$ref": "#/$defs/id" }
      }
    },
    "transition": {
      "type": "object",
      "required": ["id", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "on": { "$ref": "#/$defs/trigger" },
        "condition": { "$ref": "#/$defs/condition" },
        "role": { "type": "string" },
        "action": { "type": "string" },
        "args": { "type": "object" },
        "description": { "type": "string" }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "event": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "minLength": 1 },
        "timer": { "$ref": "#/$defs/id" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/clause" } },
        "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/clause" } }
      }
    },
    "clause": {
      "type": "object",
      "required": ["field", "op"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "op": {
          "enum": ["==", "!=", ">", ">=", "<", "<=", "in", "exists", "not_exists"]
        },
        "value": {}
      }
    },
    "timer": {
      "type": "object",
      "required": ["id", "state", "at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "state": { "type": "string", "minLength": 1 },
        "at": {
          "type": "string",
          "minLength": 1,
          "description": "ISO-8601 datetime or ${var} reference resolved at runtime"
        }
      }
    },
    "forbiddenTransition": {
      "type": "object",
      "required": ["id", "from", "to", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "enum": ["actor", "decision", "timestamp", "variables", "event", "action"]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
