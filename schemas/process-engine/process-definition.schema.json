{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tribe.partnr.icu/schemas/process-definition-0.2.json",
  "title": "Tribe Process Definition v0.2",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "contextType",
    "passport",
    "roles",
    "data",
    "states",
    "transitions"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.3"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "contextType": {
      "type": "string"
    },
    "host": {
      "$ref": "#/$defs/host"
    },
    "passport": {
      "$ref": "#/$defs/passport"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataField"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "states": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "$ref": "#/$defs/state"
      }
    },
    "gateways": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/gateway"
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "timers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timer"
      }
    },
    "forbidden": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forbiddenTransition"
      }
    },
    "agent": {
      "$ref": "#/$defs/agent"
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/testCase"
      }
    },
    "audit": {
      "$ref": "#/$defs/audit"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "passport": {
      "type": "object",
      "required": [
        "owner"
      ],
      "additionalProperties": false,
      "properties": {
        "owner": {
          "$ref": "#/$defs/id"
        },
        "goal": {
          "type": "string"
        },
        "startsWhen": {
          "type": "string"
        },
        "endsWhen": {
          "type": "string"
        },
        "inScope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outOfScope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "successMetrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "target"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "role": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "human",
            "system",
            "ai"
          ]
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capability": {
          "type": "string",
          "description": "Capability, дающая роль: проверяется через групповые права"
        },
        "scopeField": {
          "type": "string",
          "description": "Поле объекта процесса, задающее группу для проверки capability"
        },
        "assigneeField": {
          "type": "string",
          "description": "Поле объекта процесса с id пользователя-исполнителя"
        },
        "groupSetting": {
          "type": "string",
          "description": "Ключ настройки сообщества, в которой лежит id группы-исполнителя"
        }
      }
    },
    "dataField": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "date",
            "datetime",
            "object",
            "array"
          ]
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "source": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "type",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "deterministic",
            "policy",
            "ai_assisted"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "workDistribution": {
      "type": "object",
      "required": [
        "performedBy"
      ],
      "additionalProperties": false,
      "properties": {
        "performedBy": {
          "enum": [
            "human",
            "system",
            "ai"
          ]
        },
        "autonomy": {
          "enum": [
            "manual",
            "assist",
            "supervised",
            "autonomous"
          ]
        },
        "approvalRequired": {
          "type": "boolean"
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "start_event",
            "end_event",
            "wait",
            "automated_task",
            "user_task"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "final": {
          "type": "boolean",
          "default": false
        },
        "action": {
          "type": "string"
        },
        "args": {
          "type": "object"
        },
        "assignedRole": {
          "$ref": "#/$defs/id"
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "description": "Сроки: sla — часы на решение задачи, reminder — когда напомнить, deadline — таймер состояния",
          "properties": {
            "sla": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "reminder": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "deadline": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          },
          "description": "Варианты решения задачи; показываются как кнопки"
        },
        "workDistribution": {
          "$ref": "#/$defs/workDistribution"
        }
      }
    },
    "gateway": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "exclusive",
            "parallel_fork",
            "parallel_join"
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredIncoming": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "onSuccess": {
          "type": "string"
        }
      }
    },
    "transition": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "on": {
          "$ref": "#/$defs/trigger"
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "role": {
          "$ref": "#/$defs/id"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionCall"
          },
          "description": "Последовательность команд; выполняется по порядку"
        },
        "ruleRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "journal": {
          "$ref": "#/$defs/journal"
        },
        "description": {
          "type": "string"
        },
        "notify": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/notify"
          },
          "description": "Уведомления участникам после перехода"
        },
        "actorMode": {
          "enum": [
            "event",
            "system"
          ],
          "default": "event",
          "description": "event — действие выполняется от имени автора события, system — от имени движка"
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "timer": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/clause"
          }
        },
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/clause"
          }
        }
      }
    },
    "clause": {
      "type": "object",
      "required": [
        "field",
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "==",
            "!=",
            ">",
            ">=",
            "<",
            "<=",
            "in",
            "exists",
            "not_exists"
          ]
        },
        "value": {}
      }
    },
    "timer": {
      "type": "object",
      "required": [
        "id",
        "state",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "minLength": 1,
          "description": "ISO-8601 datetime or ${var} reference resolved at runtime"
        }
      }
    },
    "forbiddenTransition": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "journal": {
      "type": "array",
      "items": {
        "enum": [
          "actor",
          "decision",
          "timestamp",
          "variables",
          "event",
          "action",
          "timer"
        ]
      },
      "uniqueItems": true
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "knowledgeSources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedStates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stopConditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stimulus": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "timer": {
          "$ref": "#/$defs/id"
        },
        "actor": {
          "type": "string"
        },
        "aggregate_id": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "testCase": {
      "type": "object",
      "required": [
        "id",
        "then"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string"
        },
        "given": {
          "type": "object"
        },
        "when": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stimulus"
          }
        },
        "then": {
          "type": "object",
          "required": [
            "state"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "active",
                "awaiting_user",
                "completed",
                "failed"
              ]
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "enum": [
              "actor",
              "decision",
              "timestamp",
              "variables",
              "event",
              "action"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "notify": {
      "type": "object",
      "required": [
        "to",
        "title",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "to": {
          "enum": [
            "context_owner",
            "owner",
            "actor"
          ],
          "description": "context_owner — владелец объекта процесса, owner — владельцы сообщества, actor — тот, кто совершил переход"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "link": {
          "type": "string"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": [
            "string",
            "null"
          ],
          "description": "Модуль-хозяин: процесс работает только при включённом модуле. null — процесс уровня сообщества"
        },
        "stateMap": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Соответствие статуса доменного объекта состоянию процесса — для переноса существующих объектов"
        },
        "contextUrl": {
          "type": "string",
          "description": "Шаблон ссылки на объект процесса: {community} — slug сообщества, {id} — id объекта, {поле} — атрибут объекта"
        },
        "contextPreview": {
          "type": "array",
          "description": "Поля объекта, которые показываются в карточке задачи",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "field"
                ],
                "additionalProperties": false,
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "text",
                      "link",
                      "date",
                      "money"
                    ]
                  }
                }
              }
            ]
          }
        },
        "contextLabel": {
          "type": "string",
          "description": "Шаблон человеческого названия объекта: {id} и атрибуты объекта"
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        }
      }
    },
    "actionCall": {
      "type": "object",
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "object"
        }
      }
    }
  }
}
